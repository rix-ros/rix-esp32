# --- TCP tuning for higher throughput ---
#CONFIG_LWIP_WND_SCALE=y
#CONFIG_LWIP_TCP_RCV_SCALE=2
#CONFIG_LWIP_TCP_WND_DEFAULT=32768
#CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
#CONFIG_LWIP_TCP_RTO_TIME=1000
#CONFIG_LWIP_TCP_OVERSIZE_MSS=y
#CONFIG_LWIP_TCP_QUEUE_OOSEQ=y
#CONFIG_LWIP_TCP_OOSEQ_TIMEOUT=6000
#CONFIG_LWIP_TCP_MAXRTX=12

# TCP Buffer sizes for multiple ROS2 subscribers
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=32       
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=16
CONFIG_LWIP_TCP_OOSEQ_TIMEOUT=6000


# High-performance LWIP settings
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_TASK_PRIO=20
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_TMR_INTERVAL=250

# Enable IP reassembly for fragmented packets
CONFIG_LWIP_IP4_REASSEMBLY=y
CONFIG_LWIP_IP6_REASSEMBLY=y
CONFIG_LWIP_IP_REASS_MAX_PBUFS=20

# Optimize checksums (offload to hardware where possible)
CONFIG_LWIP_CHECKSUM_CHECK_IP=n
CONFIG_LWIP_CHECKSUM_CHECK_UDP=n

# TCP Socket limits
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_LWIP_MAX_ACTIVE_TCP=32
CONFIG_LWIP_MAX_LISTENING_TCP=32

# TCP Window Scaling (for high throughput)
CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_TCP_RCV_SCALE=2


# ESP32-P4 Module has 16MB Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Partitions table because our app is so big
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Main task stack size = 8 kB
CONFIG_ESP_MAIN_TASK_STACK_SIZE= 8192
# Fun SPIRAM stuff
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y


# Use USB Serial/JTAG for console, not UART0
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_NUM=-1

# UHCI/UART ISR in IRAM
CONFIG_UHCI_ISR_HANDLER_IN_IRAM=y
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_UHCI_ISR_CACHE_SAFE=y

# Enable legacy I2C for camera
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_OV5647=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
